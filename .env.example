# Copy this file to .env before running Docker Compose and replace every placeholder.
# Keep POSTGRES_PASSWORD alphanumeric so it can safely be used in DATABASE_URL.
POSTGRES_PASSWORD=replace-with-a-long-random-alphanumeric-value
JWT_SECRET=replace-with-a-long-random-secret
JWT_REFRESH_SECRET=replace-with-a-different-long-random-secret
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-a-unique-strong-password
RESEND_API_KEY=replace-with-a-valid-resend-api-key
CLOUDINARY_CLOUD_NAME=replace-with-cloud-name
CLOUDINARY_API_KEY=replace-with-cloudinary-api-key
CLOUDINARY_API_SECRET=replace-with-cloudinary-api-secret
